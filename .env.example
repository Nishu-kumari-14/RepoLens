# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/repolens

# Model Configuration (Never hardcoded in source; supplied via environment)
# Embedding Model:
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSION=
# Generative LLM:
LLM_PROVIDER=gemini
LLM_MODEL_ID=

# External API Keys (Leave empty for local mock or user-supplied keys; never commit .env)
GEMINI_API_KEY=
GITHUB_TOKEN=

# Local Storage Paths
LANCEDB_DATA_DIR=./data/lancedb
TEMP_DIR=./temp
WASM_DIR=./wasm

# Ingestion Limits & Constraints
MAX_ARCHIVE_SIZE_MB=50
MAX_FILE_COUNT=1000
MAX_FILE_SIZE_KB=200
RATE_LIMIT_RPM=60
